# Optional: Formspree form ID so the contact form can send messages.
# Create a form at https://formspree.io, then paste only the ID (the part after /f/).
# Example: if your endpoint is https://formspree.io/f/abcdxyz, use:
FORMSPREE_FORM_ID=

# Optional: shown as a mailto fallback once you provide a real address.
# Never commit the real address if you prefer to keep it in .env.local only.
# CONTACT_EMAIL is read by the server route as a fallback label, not as a public API key.
CONTACT_EMAIL=
